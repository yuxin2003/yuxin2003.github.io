---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Photography by Yuxin Chen"
    />

    <title>Gallery | Yuxin Chen</title>
  </head>

  <body>
    <Header />

    <main>
      <section class="page-intro">
        <h1>Gallery</h1>

        <p>
          Photographs from places I have lived in, visited, and passed through.
        </p>
      </section>

      <section class="gallery-page">
        <div class="gallery-grid">
          {
            photos.map((photo) => (
              <figure class="photo-item">
                <img
                  src={photo.src}
                  alt=""
                  loading="lazy"
                />

                <figcaption>
                  {photo.location}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>
    </main>

    <style>
      .page-intro {
        max-width: 760px;

        padding-top: 120px;
        padding-bottom: 100px;
      }

      .page-intro h1 {
        margin-bottom: 24px;

        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1;
        letter-spacing: -0.05em;
      }

      .page-intro p {
        max-width: 620px;
        margin-bottom: 0;

        font-size: 1.15rem;
        line-height: 1.6;
      }

      .gallery-page {
        padding-top: 0;
        padding-bottom: 160px;
      }

      .gallery-grid {
        column-count: 3;
        column-gap: 24px;
      }

      .photo-item {
        width: 100%;

        display: inline-block;

        margin: 0 0 32px;

        break-inside: avoid;
        -webkit-column-break-inside: avoid;
        page-break-inside: avoid;
      }

      .photo-item img {
        width: 100%;
        height: auto;

        display: block;

        border-radius: 18px;
      }

      .photo-item figcaption {
        margin-top: 10px;

        color: var(--text-secondary);

        font-size: 0.82rem;
        line-height: 1.4;
      }

      @media (max-width: 900px) {
        .gallery-grid {
          column-count: 2;
          column-gap: 20px;
        }

        .photo-item {
          margin-bottom: 28px;
        }
      }

      @media (max-width: 600px) {
        .page-intro {
          padding-top: 80px;
          padding-bottom: 64px;
        }

        .gallery-grid {
          column-count: 1;
        }

        .photo-item {
          margin-bottom: 36px;
        }

        .photo-item img {
          border-radius: 14px;
        }
      }
    </style>
  </body>
</html>