---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { courses } from "../data/teaching";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Teaching by Yuxin Chen"
    />

    <title>Teaching | Yuxin Chen</title>
  </head>

  <body>
    <Header />

    <main>
      <section class="page-intro">
        <h1>Teaching</h1>

        <p>
          Courses and teaching materials on misinformation, communication
          research, and public opinion analysis.
        </p>
      </section>

      <section class="courses-section">
        {
          courses.map((course) => (
            <article class="course">
              <div class="course-meta">
                <span>{course.level}</span>
                <span>{course.year}</span>
              </div>

              <div class="course-content">
                <h2>{course.title}</h2>

                <p>
                  {course.description}
                </p>

                <div class="course-links">
                  {
                    course.showSyllabus && course.syllabus && (
                      <div class="course-links"></div>
                      <a
                        href={course.syllabus}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Syllabus ↓
                      </a>
                    )
                  }
                </div>
              </div>

              <div class="course-page-image">
                <img
                  src={course.image}
                  alt={course.title}
                  loading="lazy"
                />
              </div>
            </article>
          ))
        }
      </section>
<div class="page-note">
  <p>
    Courses for which I served as a teaching assistant rather than the
    instructor of record are listed in my <a href="/cv">CV</a>.
  </p>
</div>

    </main>

    <style>
      .page-intro {
        max-width: 820px;

        padding-top: 40px;
        padding-bottom: 80px;
      }

      .page-intro h1 {
        margin-bottom: 28px;

        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1;
        letter-spacing: -0.05em;
      }

      .page-intro p {
        max-width: 700px;
        margin-bottom: 0;

        font-size: 1.2rem;
        line-height: 1.6;
      }

      .courses-section {
        padding-top: 0;
        padding-bottom: 140px;
      }

      .course {
        display: grid;
        grid-template-columns: 130px minmax(0, 1fr) 220px;
        gap: 36px;
        align-items: start;

        padding: 32px 0;

        border-top: 1px solid var(--border);
      }

      .course:last-child {
        border-bottom: 1px solid var(--border);
      }

      .course-meta {
        display: flex;
        flex-direction: column;
        gap: 6px;

        color: var(--text-secondary);

        font-size: 0.85rem;
        line-height: 1.5;
      }

      .course-content {
        max-width: 700px;
      }

      .course-content h2 {
        margin-bottom: 18px;

        font-size: clamp(1.8rem, 3vw, 2.6rem);
        line-height: 1.1;
        letter-spacing: -0.035em;
      }

      .course-content p {
        max-width: 680px;
        margin-bottom: 24px;

        font-size: 1rem;
        line-height: 1.7;
      }

      .course-links {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      .course-links a {
        color: var(--text-primary);

        font-size: 0.92rem;
        font-weight: 500;

        transition: opacity 0.2s ease;
      }

      .course-links a:hover {
        opacity: 0.65;
      }

      .course-page-image {
        width: 220px;
        aspect-ratio: 4 / 3;

        overflow: hidden;

        border-radius: 18px;
        background: var(--surface);
      }

      .course-page-image img {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;
      }

      @media (max-width: 900px) {
        .course {
          grid-template-columns: 120px minmax(0, 1fr) 220px;
          gap: 28px;
        }

        .course-page-image {
          width: 220px;
        }
      }

      @media (max-width: 700px) {
        .page-intro {
          padding-top: 40px;
          padding-bottom: 72px;
        }

        .course {
          grid-template-columns: 1fr;
          gap: 18px;
        }

        .course-meta {
          flex-direction: row;
          gap: 14px;
        }

        .course-page-image {
          width: 100%;
          max-width: 420px;
        }
      }

      .page-note {
  padding: 40px 0 96px;

  border-top: 1px solid var(--border);
}

.page-note p {
  margin: 0;

  color: var(--text-secondary);

  font-size: 0.92rem;
  line-height: 1.6;
}

.page-note a {
  color: var(--text-primary);
  font-weight: 500;

  transition: opacity 0.2s ease;
}

.page-note a:hover {
  opacity: 0.65;
}
    </style>
  </body>
</html>