---
import "../styles/global.css";
import Header from "../components/Header.astro";

const {
  frontmatter
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content={frontmatter.description}
    />

    <title>{frontmatter.title} | Yuxin Chen</title>
  </head>

  <body>
    <Header />

    <main>
      <article class="post">
        <header class="post-header">
          <a class="back-link" href="/posts">
            ← Posts
          </a>

          <p class="post-date">
            {frontmatter.date}
          </p>

          <h1>
            {frontmatter.title}
          </h1>

          <p class="post-description">
            {frontmatter.description}
          </p>
        </header>

        <div class="post-content">
          <slot />
        </div>
      </article>
    </main>

    <style>
      .post {
        max-width: 820px;

        margin: 0 auto;
        padding-top: 100px;
        padding-bottom: 140px;
      }

      .post-header {
        margin-bottom: 72px;
      }

      .back-link {
        display: inline-block;
        margin-bottom: 64px;

        color: var(--text-secondary);

        font-size: 0.92rem;
      }

      .back-link:hover {
        color: var(--text-primary);
      }

      .post-date {
        margin-bottom: 18px;

        color: var(--text-secondary);

        font-size: 0.88rem;
        font-weight: 500;
      }

      .post-header h1 {
        margin-bottom: 24px;

        font-size: clamp(2.8rem, 6vw, 5rem);
        line-height: 1.02;
        letter-spacing: -0.05em;
      }

      .post-description {
        max-width: 700px;
        margin-bottom: 0;

        font-size: 1.2rem;
        line-height: 1.55;
      }

      .post-content {
        max-width: 720px;
      }

      .post-content :global(p) {
        margin-bottom: 1.6em;

        color: var(--text-primary);

        font-size: 1.05rem;
        line-height: 1.8;
      }

      .post-content :global(h2) {
        margin-top: 2.2em;
        margin-bottom: 0.8em;

        font-size: 1.8rem;
        line-height: 1.2;
      }

      .post-content :global(h3) {
        margin-top: 2em;
        margin-bottom: 0.7em;
      }

      .post-content :global(a) {
        color: var(--accent);
      }

      @media (max-width: 700px) {
        .post {
          padding-top: 72px;
          padding-bottom: 100px;
        }

        .back-link {
          margin-bottom: 48px;
        }

        .post-header {
          margin-bottom: 52px;
        }
      }
    </style>
  </body>
</html>